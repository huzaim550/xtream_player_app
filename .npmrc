# react-native is aliased to the react-native-tvos fork, whose versions carry a
# build suffix (0.85.3-3). npm's semver reads that as a prerelease, and a plain
# range like reanimated's `react-native@"0.81 - 0.85"` never matches a
# prerelease -- so every install ERESOLVEs on a conflict that isn't real.
# The underlying 0.85.3 is exactly what Expo SDK 56 pins.
legacy-peer-deps=true
