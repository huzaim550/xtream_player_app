{
  "name": "xtream_player_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "prebuild:phone": "expo prebuild --clean -p android",
    "android:phone": "npm run prebuild:phone && expo run:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "patch-package",
    "patch:expo-video": "python3 scripts/patch-expo-video.py && npx patch-package expo-video"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.3",
    "expo-application": "~56.0.3",
    "expo-build-properties": "~56.0.13",
    "expo-constants": "~56.0.14",
    "expo-dev-client": "~56.0.14",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.8",
    "expo-intent-launcher": "~56.0.4",
    "expo-keep-awake": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-navigation-bar": "~56.0.3",
    "expo-router": "~56.2.5",
    "expo-screen-orientation": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.23",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
