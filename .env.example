# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time,
# so put nothing secret here -- credentials belong in SecureStore, entered at
# the login screen.
#
# Everything below is optional. An empty .env produces the normal sideload build.

# Which shop this build is for: sideload (the default) or play.
#
#   sideload -> the APK the family installs by hand. Carries the in-app updater
#               and self-hosted OTA updates.
#   play     -> the Play Store build. Both of those are compiled out: an app
#               that downloads and installs an APK violates Play's Device and
#               Network Abuse policy.
#
# Any other value fails the build on purpose, so a typo cannot quietly produce a
# sideload binary bound for the store.
# EXPO_PUBLIC_DISTRIBUTION=play

# Allow plain-http requests, for a local dev server only:
#   emulator        -> http://10.0.2.2:8000
#   physical device -> adb reverse tcp:8000 tcp:8000, then http://localhost:8000
# Never set this for a build anyone else installs. Ignored entirely when
# EXPO_PUBLIC_DISTRIBUTION=play.
# EXPO_PUBLIC_ALLOW_CLEARTEXT=1

# Your device's hashed AdMob id, so a release build on your own phone serves
# test ads rather than live ones. The SDK prints it to logcat on the first ad
# request. Tapping a live ad on your own device is how AdMob accounts get
# terminated, and __DEV__ is false in a release build, so this is the only
# protection that applies there.
# EXPO_PUBLIC_ADMOB_TEST_DEVICE=
