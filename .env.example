# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time,
# so put nothing secret here -- credentials belong in SecureStore, entered at
# the login screen.

# Prefills the server field on the login screen. Typing a URL on a TV remote is
# miserable, so this is worth setting.
EXPO_PUBLIC_DEFAULT_SERVER_URL=https://iptv.example.com

# Pointing at a local dev server instead:
#   emulator        -> http://10.0.2.2:8000
#   physical device -> adb reverse tcp:8000 tcp:8000, then http://localhost:8000
# Cleartext HTTP is permitted in dev builds only (see app.config.ts).
